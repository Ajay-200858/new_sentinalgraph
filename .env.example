# ============================================================
# SentinelGraph — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/sentinelgraph

# -- SentinelGraph tuning -----------------------------------------------------
# Risk score 0-100 above which a Caspian alert is triggered (default: 60)
SENTINELGRAPH_RISK_THRESHOLD=60

# Minutes between repeated alerts for the same attack_type + source_ip (default: 15)
SENTINELGRAPH_ALERT_INTERVAL=15

# Display name used in alert messages (default: SentinelGraph)
SENTINELGRAPH_AGENT_NAME=SentinelGraph

# -- Caspian alerting ---------------------------------------------------------
# Behaviour by variable combination:
#
#   CASPIAN_API_KEY missing
#       -> status: NOT CONFIGURED
#       -> application continues normally, no alerts sent
#
#   CASPIAN_API_KEY present, CASPIAN_ALERT_CONVERSATION_ID missing
#       -> status: DESTINATION NOT SET
#       -> client is created but no alerts are sent
#       -> application continues normally
#
#   CASPIAN_API_KEY + CASPIAN_ALERT_CONVERSATION_ID both present
#       -> status: READY
#       -> security alerts above threshold are sent to that conversation only
#
# SDK: caspian-sdk==1.0.2  (package: caspian)
# API: POST /v1/conversations/{CASPIAN_ALERT_CONVERSATION_ID}/messages
#
CASPIAN_API_KEY=
CASPIAN_BASE_URL=
CASPIAN_ALERT_CONVERSATION_ID=
